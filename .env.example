# Banco. Local (docker-compose):
DATABASE_URL="postgresql://maison:maison_dev@localhost:5432/maison_du_pain"
# Supabase: use o "Session pooler" (funciona em IPv4; o host direto db.<ref>.supabase.co é só IPv6):
# DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-1-<regiao>.pooler.supabase.com:5432/postgres"

# Opcional: conexões por instância do app (1 a 50). Padrão: 3 em produção, 10 em desenvolvimento
# DB_POOL_MAX="3"

# Segredo da sessão (mín. 32 caracteres). Gere com: openssl rand -base64 32
AUTH_SECRET=""

# Opcional: conexão direta só para migrations (quando DATABASE_URL usa pooler em modo transação)
# DIRECT_URL=""

# Opcional, só desenvolvimento/demonstração: cria admin@, equipe@ e cliente@maisondupain.example com esta senha
# SEED_DEMO_PASSWORD=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Mercado Pago (credenciais de TESTE, começam com TEST-). Vazio em desenvolvimento = modo simulado.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Email transacional
EMAIL_FROM="Maison du Pain <no-reply@example.com>"
RESEND_API_KEY=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
